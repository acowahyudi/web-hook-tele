# ========================================================
# Telegram Bot & Webhook Configuration
# ========================================================
PORT=3000

# Token Bot Telegram yang didapatkan dari @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# ID Grup Telegram resmi yang diizinkan (gunakan tanda minus '-' untuk grup/supergroup)
# Untuk beberapa grup, pisahkan dengan koma: -1001234567890,-1009876543210
ALLOWED_CHAT_ID=-1001234567890

# Token rahasia yang dikirim Telegram di header X-Telegram-Bot-Api-Secret-Token
# Buat string acak (1-256 karakter: [A-Za-z0-9_-])
TELEGRAM_SECRET_TOKEN=my_super_secret_webhook_token_123456

# ========================================================
# GitLab Global Configuration
# ========================================================
# Host GitLab (gunakan https://gitlab.com atau domain GitLab self-hosted Anda)
GITLAB_HOST=https://gitlab.com

# ========================================================
# Project A Configuration
# ========================================================
# Pipeline Trigger Token dibuat di: Settings > CI/CD > Pipeline trigger tokens
TRIGGER_TOKEN_PROJECT_A=glptt-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PROJECT_ID_PROJECT_A=12345678
REF_PROJECT_A=main
RUNNER_TAG_PROJECT_A=my-runner-tag

# ========================================================
# Project B Configuration
# ========================================================
TRIGGER_TOKEN_PROJECT_B=glptt-yyyyyyyyyyyyyyyyyyyyyyyyyyyy
PROJECT_ID_PROJECT_B=87654321
REF_PROJECT_B=production
RUNNER_TAG_PROJECT_B=default-runner
